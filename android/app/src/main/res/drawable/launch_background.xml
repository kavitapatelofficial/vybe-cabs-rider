<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by the OS while the process starts, before Flutter draws a frame.
     Kept identical to the in-app splash so the handover is invisible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/vybe_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/vybe_logo" />
    </item>
</layer-list>
