<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window shown while the process starts. The app has no light theme, so
         this stays dark regardless of the system setting; the stock Flutter
         template used Theme.Light here, which produced a white flash on launch. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied once the process is up: the colour behind the Flutter UI while
         it initialises. Pinned to the app background rather than
         ?android:colorBackground, which resolves to white in light mode. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/vybe_background</item>
    </style>
</resources>
